generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Untitled")
  content   Json?
  pdfUrl    String?
  epubUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
